<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E0E0E0"/> <!-- Lighter shade for pressed state -->
            <!-- Optionally, define corners, padding, size, etc. -->
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/red"/> <!-- Your desired background color -->
            <!-- Optionally, define corners, padding, size, etc. -->
        </shape>
    </item>
</selector>