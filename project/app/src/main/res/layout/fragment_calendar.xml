<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CalendarFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:background="@color/gray"
            android:layout_centerHorizontal="true"
            android:textColor="@color/white"
            android:id="@+id/monthYearTextTv"
            android:padding="5dp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_gravity="center"
            android:text="Month Year" />

        <com.github.sundeepk.compactcalendarview.CompactCalendarView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_below="@+id/monthYearTextTv"
            android:id="@+id/calendarView"
            android:layout_width="fill_parent"
            android:layout_height="200dp"
            app:compactCalendarTargetHeight="200dp"
            app:compactCalendarTextSize="14sp"
            app:compactCalendarBackgroundColor="@color/black"
            app:compactCalendarTextColor="#fff"
            app:compactCalendarMultiEventIndicatorColor="#fff" />

        <TextView
            android:layout_below="@+id/calendarView"
            android:id="@+id/headerTV"
            android:text="Εργασίες"
            android:padding="5dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:background="@color/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ListView
            android:layout_below="@+id/headerTV"
            android:id="@+id/listView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </RelativeLayout>

</FrameLayout>